# Normalize line endings: always LF in the repo, CI and Linux get LF, Windows checkout gets CRLF
* text=auto eol=lf

# Force these always LF (shell scripts, YAML, Python, JSX)
*.sh       text eol=lf
*.py       text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.jsx      text eol=lf
*.js       text eol=lf
*.ts       text eol=lf
*.tsx      text eol=lf
*.css      text eol=lf
*.html     text eol=lf
*.json     text eol=lf
*.md       text eol=lf
*.txt      text eol=lf

# Binaries — no line-ending conversion
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.woff     binary
*.woff2    binary
*.ttf      binary
*.eot      binary

